{
  "name": "func-info",
  "displayName": "Func Info",
  "description": "",
  "version": "0.0.1",

  "engines": {
    "vscode": "^1.120.0"
  },

  "categories": [
    "Other"
  ],

  "activationEvents": [
    "onCommand:funcInfo.showFunctions",
    "onView:functionExplorer"
  ],

  "main": "./out/extension.js",

  "contributes": {
     "commands": [
       {
         "command":"funcInfo.showFunctions",
         "title":"Func Info"
       }
     ],
 
     "viewsContainers": {
       "activitybar": [
         {
           "id":"funcInfoSidebar",
           "title":"Func Info",
           "icon":"$(symbol-function)"
         }
       ]
     },
 
     "views": {
       "funcInfoSidebar": [
         {
           "id":"functionExplorer",
           "name":"Function Info"
         }
       ]
     }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },

  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/node": "22.x",
    "typescript": "^5.9.3"
  }
}